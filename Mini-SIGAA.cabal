cabal-version:      2.4
name:               Mini-SIGAA
version:            0.1.0.0
synopsis:           Sistema de Gestão Acadêmica simplificado em Brick
build-type:         Simple

common dependencies
    build-depends:    base >= 4.14 && < 5
                    , aeson
                    , aeson-pretty
                    , brick
                    , bytestring
                    , containers
                    , directory
                    , microlens
                    , microlens-ghc
                    , microlens-mtl
                    , microlens-th
                    , mtl
                    , text
                    , vector
                    , vty
    default-language: Haskell2010
    ghc-options:      -Wall

library
    import:           dependencies
    hs-source-dirs:   src
    exposed-modules:  Models.Aluno
                    , Models.Professor
                    , Models.Disciplina
                    , Models.Turma
                    , Models.Matricula
                    , Models.PerfilAcademico
                    , Models.Types
                    , Sistema
                    , Utils.Database
                    , Menu.Tipos
                    , Menu.UI.UI
                    , Menu.UI.Common
                    , Menu.UI.Listas
                    , Menu.UI.Agenda
                    , Menu.Eventos.Events
                    , Menu.Eventos.FaseCadastro
                    , Menu.Eventos.FaseMatricula
                    , Menu.Eventos.FaseNotas
                    , Menu.Eventos.Util

executable mini-sigaa
    import:           dependencies
    main-is:          Main.hs
    build-depends:    Mini-SIGAA
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N